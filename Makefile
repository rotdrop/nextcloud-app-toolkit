COMPOSER ?= composer
PHP ?= php

# Composer refuses to run plugins as root without this, harmless otherwise.
export COMPOSER_ALLOW_SUPERUSER ?= 1
export XDEBUG_MODE ?= off

PHPUNIT = vendor/bin/phpunit

.DEFAULT_GOAL := help

.PHONY: help
help:
	@echo "Targets:"
	@echo "  help   Show this help (default)."
	@echo "  test   Install all dependencies and run the PHPUnit test-suite."
	@echo "  clean  Remove everything generated by 'make test', including composer.lock files."

# composer install is forwarded to vendor-bin/* by the bamarni plugin.
vendor/autoload.php: composer.json vendor-bin/phpunit/composer.json
	$(COMPOSER) install
	@touch $@

.PHONY: test
test: vendor/autoload.php
	$(PHPUNIT)

.PHONY: clean
clean:
	rm -rf vendor vendor-bin/*/vendor .phpunit.cache build
	rm -f composer.lock vendor-bin/*/composer.lock
